  "body": {
    "format": "articles",
    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 지침은 한국여성과학기술인육성재단(이하 \"재단\"이라 한다.)의 임금피크제 운영에 관한 세부사항을 정함을 목적으로 한다. <개정 2021. 6. 1.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국여성과학기술인육성재단)임금피크제운영지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "용어의 정의",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(용어의 정의) ① \"임금피크제\"라 함은 근로자의 정년이 도달하기 이전 일정기간 동안 고용을 보장하고, 해당 기간 동안 임금을 일정비율 조정하는 제도를 말한다.② 임금피크제 적용대상 직원의 임금지급률 산정기준이 되는 \"피크임금\"은 임금피크제 적용 직전의 \"기본급\"으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국여성과학기술인육성재단)임금피크제운영지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "적용대상",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(적용대상) 임금피크제의 적용은 재단 정규직 및 무기계약직원을 대상으로 한다. <개정 2021. 6. 1.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국여성과학기술인육성재단)임금피크제운영지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "임금조정기간",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(임금조정기간) 임금피크제의 적용은 정년퇴직일 이전 2년간으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국여성과학기술인육성재단)임금피크제운영지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "임금의 조정",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(임금의 조정) 임금피크제 연차별 임금지급률은 피크임금을 기준으로 아래와 같이 시행한다. 단, 기준 금액은 매년 임금인상률을 반영하여 적용한다.1. 1차년도: 90%2. 2차년도: 85%",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국여성과학기술인육성재단)임금피크제운영지침#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "적용통지",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(적용통지) 인사담당부서장은 임금피크제 대상 직원에게 제5조에 따른 기준일 이전에 임금조정내역을 통지하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국여성과학기술인육성재단)임금피크제운영지침#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "직무부여",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(직무부여) 임금피크제 대상 직원에 대해서는 임금피크제 적용기간 동안 이사장이 정한 별도의 직무범위 내에서 직원의 희망직무, 직무적합도 및 직무별 인력소요현황 등을 고려하여 직무를 부여할 수 있다. <개정 2021. 6. 1.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국여성과학기술인육성재단)임금피크제운영지침#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "계약직 전환",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(계약직 전환) 이사장은 필요시 정년 퇴직 직원을 계약직으로 고용할 수 있다. <개정 2021. 6. 1.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국여성과학기술인육성재단)임금피크제운영지침#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "근로조건 등",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(근로조건 등) 이 지침에서 정하지 않은 근로조건과 복리후생에 관한 사항은 재단 관련 규정의 내용에 따라 다른 직원과 동일하게 적용한다. <개정 2021. 6. 1.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국여성과학기술인육성재단)임금피크제운영지침#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "우선효력",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(우선효력) 재단의 모든 규정 중 본 지침의 내용과 충돌하는 사항이 있는 경우에는 본 지침을 우선적으로 적용한다. <개정 2021. 6. 1.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:(한국여성과학기술인육성재단)임금피크제운영지침#JO0010"
      }
    ]
  },
