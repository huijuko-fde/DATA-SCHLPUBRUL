  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 내규는 김해시도시개발공사(이하 “공사”라 한다) 직원의 신분을 표시하는 신분증의 규격, 제식 및 발급 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:김해시도시개발공사신분증발급내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용범위) 이 내규는 공사에 근무하는 모든 임직원에게 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:김해시도시개발공사신분증발급내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "신분증의 규격과 제식",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(신분증의 규격과 제식) 신분증의 규격, 제식 및 기재사항, 색채 등은 사장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:김해시도시개발공사신분증발급내규#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "신분증의 발급권자",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(신분증의 발급권자) 사장은 그 소속직원에 대한 신분증을 발급하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:김해시도시개발공사신분증발급내규#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "신분증의 휴대 및 달기",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(신분증의 휴대 및 달기) ① 직원은 늘 신분증을 지녀야 하며, 공무집행 중에 있어 보여줄 것을 요구받은 때에는 이를 내보여야 한다.② 직원은 공사 내에서는 신분증을 달아야 한다.③ 신분증을 다는 때에는 왼쪽가슴에 달아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:김해시도시개발공사신분증발급내규#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "신분증의 발급 및 재발급",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(신분증의 발급 및 재발급) ① 신분증 발급자가 신분증을 발급할 때에는 별지 제1호서식에 의한 신분증 발급대장에 등록한 후에 행하여야 한다.② 신분증에 부착된 사진은 발급일전 6월이내에 찍은 것이어야 한다.③ 신분증의 분실, 파손 또는 기재사항의 변동으로 재발급을 받고자 하는 직원은 그 사유가 발생한 날로부터 5일 이내에 별지 제2호서식에 의한 신분증 재발급 신청서를 신분증 발급권자에게 제출하여야 한다.④ 신분증 발급권자는 신규직원이 있을 때에는 신분증을 발급하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:김해시도시개발공사신분증발급내규#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "신분증의 반납",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(신분증의 반납) 사장은 직원이 퇴직하는 때에는 신분증을 회수하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:김해시도시개발공사신분증발급내규#JO0007"
      }
    ]
  },
