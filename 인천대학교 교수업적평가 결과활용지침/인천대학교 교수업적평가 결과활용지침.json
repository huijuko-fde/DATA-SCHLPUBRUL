  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 지침은 인천대학교 교수업적평가규정 제21조에 의한 교수업적평가결과(이하 평가결과라 한다)의 활용에 대한 세부사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교교수업적평가결과활용지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용기준",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(적용기준) ① 교수업적평가 결과 활용을 위한 업적평가대상기간은 직전 2개 년도의 평가결과를 적용하는 것을 원칙으로 한다.② 6개월 이상 휴직한 경우에는 평가가 이루어진 직전 2개 년도 평가결과를 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교교수업적평가결과활용지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "적용기간",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(적용기간) 평가결과 활용의 적용기간은 평가결과의 확정 후부터 차기년도의 평가결과 확정시까지로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교교수업적평가결과활용지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "적용분야",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(적용분야) 평가결과는 교원 연구년제 운영 기준으로 활용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교교수업적평가결과활용지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "교원 연구년제 기준 활용",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(교원 연구년제 기준 활용) 인천대학교 교원 연구년제 운영지침 제2조에 의한 자격에 해당되어도 직전 2개 년도에 연속하여 평가결과의 연구영역의 실적순위 하위 15% 이면서 영역별 원점수의 총합이 100점 미만인 경우 교원 연구년제 추천, 선정, 시행을 금지한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교교수업적평가결과활용지침#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "교수업적평가결과의 제공",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(교수업적평가결과의 제공) 교수업적평가규정 제22조의 규정에도 불구하고 본 지침에 의한 결과활용을 위해서는 최소한의 범위내에서 해당 부서 및 담당자에게 결과를 제공할 수 있다. 단 제공받은 부서 및 담당자는 대외비로 관리하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교교수업적평가결과활용지침#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "기타",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(기타) 이 지침에 규정되지 않은 사항은 교무회의를 거쳐 총장이 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교교수업적평가결과활용지침#JO0007"
      }
    ]
