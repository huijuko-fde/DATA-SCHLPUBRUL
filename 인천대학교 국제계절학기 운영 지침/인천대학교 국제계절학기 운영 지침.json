    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 지침은「인천대학교 계절학기 운영에 관한 규정」제2조에 따라 국제계절학기 운영에 관한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교국제계절학기운영지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "개설시기",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(개설시기) 국제계절학기는 방학 중에 개설한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교국제계절학기운영지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "교과목개설",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(교과목개설) 국제계절학기는 국제적 소양 함양에 도움이 되는 언어, 사회, 문화, 정치 등 전반에 걸쳐 개설하는 과목으로 구성한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교국제계절학기운영지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "수강대상",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(수강대상) 국제계절학기의 수강대상은 본교 재적생 및 국내ㆍ외 다른 대학의 내ㆍ외국인 재적생으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교국제계절학기운영지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "수강학점",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(수강학점) 국제계절학기로 본교에서 인정받을 수 있는 학점은 학기당 최대 9학점 이내로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교국제계절학기운영지침#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "수강등록",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(수강등록) 국제계절학기를 수강하고자 하는 자는 소정의 기간 내 등록을 완료하고 수강신청을 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교국제계절학기운영지침#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "수강료",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(수강료) 수강료는 개설학점 단위로 총장이 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교국제계절학기운영지침#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "강사위촉",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(강사위촉) 국제계절학기 운영을 위하여 개강 30일 전까지 강사를 위촉한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교국제계절학기운영지침#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "학기운영",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(학기운영) 국제계절학기는 방학기간 중 6주 이내로 운영함을 원칙으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교국제계절학기운영지침#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "강의시간",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(강의시간) 국제계절학기 개설 교과목의 강의시간은 학점 당 15시간을 원칙으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교국제계절학기운영지침#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "성적평가 및 처리",
        "chapter": "",
        "chapter_path": "",
        "content": "제11조(성적평가 및 처리) 국제계절학기의 성적평가는 정규학기의 평가방법과 같으며, 성적 처리 후 수강생에게 성적증명서를 발급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교국제계절학기운영지침#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "성적인정",
        "chapter": "",
        "chapter_path": "",
        "content": "제12조(성적인정) 국제계절학기에서 취득한 성적은 본교 학생의 경우 학칙에 규정된 학점으로 인정하되 정규학기 평균산출에는 합산하지 않고, 전체성적(졸업학점)의 평점평균에는 산입한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교국제계절학기운영지침#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "준용",
        "chapter": "",
        "chapter_path": "",
        "content": "제13조(준용) 그 밖에 국제계절학기의 운영 등에 관하여 이 지침에 명시되지 않은 사항은 본교 학칙 및 규정 등을 준용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교국제계절학기운영지침#JO0013"
      }
    ]
  },
