  "body": {
    "format": "articles",
    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "chapter_path": "",
        "content": "제1조(목적) 이 지침은 국립대학법인 인천대학교(이하 “본교”라 한다) 중국학술원(이하 “학술원”이라 한다) 상임연구원의 임용, 인사, 성과평가, 대우 및 그 밖에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교중국학술원상임연구원임용및대우등에관한지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "chapter_path": "",
        "content": "제2조(정의) 상임연구원이라 함은 학술원의 연구 및 각종 사업 수행 등을 위하여 계약에 의해 고용된 자체계약직 연구원을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교중국학술원상임연구원임용및대우등에관한지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "임용자격",
        "chapter": "",
        "chapter_path": "",
        "content": "제3조(임용자격) ① 상임연구원의 임용자격은 「국가공무원법」 제33조에 따른 결격사유가 없는 자로 한다.② 상임연구원은 연구경력에 따라 다음 각 호와 같이 구분한다.1. 연구위원 : 박사학위 소지자로서 조교수급 이상인 자 또는 이와 동등한 연구       경력을 갖춘 자2. 연구원 : 석사학위 이상 소지자",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교중국학술원상임연구원임용및대우등에관한지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "임용절차",
        "chapter": "",
        "chapter_path": "",
        "content": "제4조(임용절차) ① 상임연구원은 중국학술원장(이하 “원장”이라 한다)의 추천으로 총장이 임명하고, 임용기간은 1년으로 한다.② 원장이 상임연구원의 임명을 추진하고자 할 때에는 임용예정일 15일 전까지 총장에게 다음 각 호의 서류를 제출하여야 한다.1. 응시원서 및 자기소개서2. 연구계획서 및 연구업적3. 최종 학위(예정) 증명서4. 성적증명서(학사, 석사, 박사)5. 경력 및 재직증명서(해당자)6. 어학성적 및 자격증 사본(해당자)7. 기타 필요 서류",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교중국학술원상임연구원임용및대우등에관한지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "의무",
        "chapter": "",
        "chapter_path": "",
        "content": "제5조(의무) ① 상임연구원은 임용일로부터 15일 이내에 성과목표계획서를 제출하여야 하고, 원장은 이를 근거로 하여 상임연구원의 성과를 평가한다.② 상임연구원의 본교 및 타 기관 강의는 원칙적으로 불허하되 부득이한 경우 연구에 지장을 주지 않는 범위 내에서 총장의 승인을 받아 강의를 담당하게 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교중국학술원상임연구원임용및대우등에관한지침#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "재임용",
        "chapter": "",
        "chapter_path": "",
        "content": "제6조(재임용) ① 원장은 임용기간이 만료되는 상임연구원의 성과목표계획을 평가하여 재임용 여부를 결정하며 제4조제1항의 절차에 따라 재임용할 수 있다.② 재임용 시 제4조제2항의 서류 중 연구계획서 및 연구업적에 한하여 제출한다.③ 제1항에 따른 평가 결과 재임용 대상자로 선정되지 아니하거나 상임연구원 담당 사업의 중단 또는 예산 부족으로 인건비지급을 유지할 수 없을 시에는 임용기간 만료 후 재임용하지 않을 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교중국학술원상임연구원임용및대우등에관한지침#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "해임",
        "chapter": "",
        "chapter_path": "",
        "content": "제7조(해임) 총장은 상임연구원이 임용기간 중 계약상의 계약조건을 위반하거나 상임연구원에게「인천대학교 직원 인사 규정」 제46조제1항에 해당하는 사유가 있다고 인정될 때에는 원장의 요청에 의하여 학술원 운영위원회의 심의를 거쳐 상임연구원을 해임할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교중국학술원상임연구원임용및대우등에관한지침#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "면직",
        "chapter": "",
        "chapter_path": "",
        "content": "제8조(면직) ① 상임연구원은 면직을 희망하는 경우 면직희망일 15일 전까지 학술원에 사직서를 제출하여야 한다.② 임용기간이 만료되었으나 재임용 요청이 없을 시에는 별도의 통지 없이 자동 면직된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교중국학술원상임연구원임용및대우등에관한지침#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "급여",
        "chapter": "",
        "chapter_path": "",
        "content": "제9조(급여) 상임연구원의 급여는 본교 예산편성 지침을 우선적으로 적용하며 자격 및 경력 등에 따라 예산의 범위 안에서 총장이 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교중국학술원상임연구원임용및대우등에관한지침#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "퇴직금",
        "chapter": "",
        "chapter_path": "",
        "content": "제10조(퇴직금) ① 상임연구원의 임용 시 인건비 재원에 퇴직금을 확보하여야 한다.② 상임연구원이 1년 이상 근속하고 퇴직하는 경우,「근로자퇴직급여 보장법」에 의거하여 퇴직금을 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "SchlPubRul:인천대학교중국학술원상임연구원임용및대우등에관한지침#JO0010"
      }
    ]
